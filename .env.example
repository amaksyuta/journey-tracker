# Copy to .env (docker compose reads it). Never commit the real .env.
JWT_SECRET=change-me-to-a-64-char-random-string
ACCESS_TOKEN_MINUTES=120
GUEST_LOGIN_ENABLED=true
APPEALS_REQUIRE_COUNCIL=false
SEED_DEMO_DATA=true
# SQLite file inside the container volume; switch to PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg://journey:secret@db:5432/journey
DATABASE_URL=sqlite:////data/journey.db
